+#[cfg(not(feature = "dummy-fairplay"))]
+fn fairplay_sign(os_config: &dyn OSConfig, data: &[u8]) -> Result<(Vec<u8>, Vec<u8>), PushError> {
+    let directory = os_config
+        .get_fairplay_keys_dir()
+        .ok_or(PushError::FairplaySignerUnavailable)?;
+    let mut pairs = Vec::with_capacity(FAIRPLAY_NAMES.len());
+    for name in FAIRPLAY_NAMES {
+        let certificate = fs::read(directory.join(format!("{name}.crt")))
+            .map_err(|_| PushError::FairplayMaterialUnavailable)?;
+        let private_key = fs::read(directory.join(format!("{name}.pem")))
+            .map_err(|_| PushError::FairplayMaterialUnavailable)?;
+        let certificate = X509::from_der(&certificate)
+            .map_err(|_| PushError::FairplayMaterialInvalid)?;
+        let private_key = PKey::private_key_from_der(&private_key)
+            .map_err(|_| PushError::FairplayMaterialInvalid)?;
+        let certificate_public_key = certificate
+            .public_key()
+            .and_then(|key| key.public_key_to_der())
+            .map_err(|_| PushError::FairplayMaterialInvalid)?;
+        let private_public_key = private_key
+            .public_key_to_der()
+            .map_err(|_| PushError::FairplayMaterialInvalid)?;
+        if certificate_public_key != private_public_key {
+            return Err(PushError::FairplayMaterialInvalid);
+        }
+        pairs.push((certificate.to_der()?, private_key));
+    }
+    let (certificate, private_key) = pairs
+        .choose(&mut thread_rng())
+        .ok_or(PushError::FairplayMaterialUnavailable)?;
+    let mut signer = Signer::new(MessageDigest::sha1(), private_key)?;
